<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Temporary root-only redirect to sensorial book landing.
  RewriteRule ^$ https://sensorial.pameflorescrea.com/libro [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
